 * PW_RECEIPT_INPUT_CLEAN の TEST_ROW をPDF化して、
 */
function runReceiptPdfDirectSendTestOne() {
  RPDS_processOneRowAndSendToSheetEmail_(RPDS_CONFIG.TEST_ROW);
